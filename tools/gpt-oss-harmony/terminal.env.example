# Set a distinct high-entropy value locally; do not commit the populated file.
HARMONY_OPEN_TERMINAL_API_KEY=replace-with-a-local-secret
# Bounded per-command retained output for the isolated terminal (1 MiB).
HARMONY_OPEN_TERMINAL_MAX_LOG_SIZE=1048576
# Set a second distinct high-entropy value locally; it is used only by the
# private Jupyter service and isolated OpenWebUI profile.
HARMONY_JUPYTER_TOKEN=replace-with-a-second-local-secret
# One concurrent kernel and a 60 second per-call deadline are the P1 limits.
HARMONY_PYTHON_TIMEOUT_SECONDS=60
# Bounded returned tool text, enforced by the Harmony Python adapter (1 MiB).
HARMONY_PYTHON_MAX_OUTPUT_BYTES=1048576
